# =============================================================================
# Ecclesia / EpaChurch - environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit a real .env file. It is git-ignored on purpose.
#
# Generate every secret below with:       openssl rand -hex 32
# =============================================================================

# --- App ---------------------------------------------------------------------
# Public HTTPS URL where this app is served. Used for links and callbacks.
APP_URL=https://church.example.com
# Port the server listens on.
PORT=3000
# Set to "production" to enable HSTS, secure cookies, TLS verification and the
# fail-fast startup configuration checks.
NODE_ENV=production

# Optional: Gemini AI features. Leave blank to disable.
GEMINI_API_KEY=

# --- Database (PostgreSQL is the default and recommended) --------------------
# Provide DATABASE_URL, OR the individual PG* credentials below.
DB_CLIENT=pg
DATABASE_URL=
PGHOST=
PGUSER=
PGPASSWORD=
PGDATABASE=ecclesia
PGPORT=5432

# Require an encrypted TLS connection to PostgreSQL. REQUIRED in production.
PGSSL=true
# Strongest option: pin your provider's CA certificate so the server
# certificate chain is fully verified. Supply the PEM inline or as a file path.
PGSSL_CA=
PGSSL_CA_PATH=
# Escape hatch ONLY (discouraged): TLS without certificate verification.
PGSSL_NO_VERIFY=false

# MySQL (only used when DB_CLIENT=mysql)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=ecclesia
DB_PORT=3306

# --- Authentication & tokens -------------------------------------------------
# REQUIRED. Minimum 32 characters. The server refuses to start in production
# with a missing, default, or weak value.
JWT_SECRET=
# REQUIRED. Must be different from JWT_SECRET so access and refresh tokens are
# cryptographically independent.
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# --- Secrets-at-rest encryption (AES-256-GCM) --------------------------------
# Encrypts provider credentials (Paystack secret key, SMTP/SMS passwords) before
# they are written to the database. REQUIRED in production: without it the key
# is derived from JWT_SECRET, so rotating JWT_SECRET would orphan stored secrets.
SECRETS_ENCRYPTION_KEY=

# --- CORS allow-list ---------------------------------------------------------
# Comma-separated browser origins permitted to call the API.
# Leave empty to allow same-origin requests only.
# Example: https://app.epachurch.com,https://admin.epachurch.com
ALLOWED_ORIGINS=

# --- Seed account passwords --------------------------------------------------
# REQUIRED in production, minimum 12 characters, and must not be a well-known
# default. The server refuses to seed the database otherwise.
# Rotate these immediately after the first successful sign-in.
SUPERADMIN_PASSWORD=
SEED_DEFAULT_PASSWORD=

# --- Notifications -----------------------------------------------------------
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=Ecclesia
MNOTIFY_CLIENT_ID=
MNOTIFY_CLIENT_SECRET=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# --- Payment gateway (Paystack) ----------------------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
